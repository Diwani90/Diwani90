# ===================================
# منصة ديواني - Environment Variables
# Copy this file to .env and fill in the values
# ===================================

# ===================================
# Django Settings
# ===================================
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=diwani.sa,www.diwani.sa,api.diwani.sa
CSRF_TRUSTED_ORIGINS=https://diwani.sa,https://www.diwani.sa
CORS_ALLOWED_ORIGINS=https://diwani.sa,https://www.diwani.sa

# ===================================
# Database (PostgreSQL + PostGIS)
# ===================================
POSTGRES_DB=diwani_db
POSTGRES_USER=diwani_user
POSTGRES_PASSWORD=your-secure-database-password
DATABASE_URL=postgis://diwani_user:your-secure-database-password@db:5432/diwani_db

# ===================================
# Redis
# ===================================
REDIS_PASSWORD=your-secure-redis-password
REDIS_URL=redis://:your-secure-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:your-secure-redis-password@redis:6379/1

# ===================================
# Gunicorn Settings
# ===================================
GUNICORN_WORKERS=4
GUNICORN_THREADS=2

# ===================================
# Celery Settings
# ===================================
CELERY_CONCURRENCY=4

# ===================================
# Monitoring (Grafana)
# ===================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-secure-grafana-password
GRAFANA_ROOT_URL=https://monitoring.diwani.sa

# ===================================
# SMS Provider (Unifonic)
# ===================================
UNIFONIC_APP_ID=your-unifonic-app-id
UNIFONIC_SENDER_ID=DIWANI

# ===================================
# Payment Gateway (Moyasar)
# ===================================
MOYASAR_API_KEY=sk_test_your-api-key
MOYASAR_PUBLISHABLE_KEY=pk_test_your-publishable-key
MOYASAR_CALLBACK_URL=https://api.diwani.sa/api/v1/payments/callback/

# ===================================
# Firebase Cloud Messaging
# ===================================
FCM_SERVER_KEY=your-fcm-server-key

# ===================================
# AWS S3 (Optional - for media storage)
# ===================================
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=diwani-media
AWS_S3_REGION_NAME=me-south-1

# ===================================
# Email (SMTP)
# ===================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@diwani.sa
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@diwani.sa

# ===================================
# Error Tracking (Sentry)
# ===================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===================================
# Admin Settings
# ===================================
ADMIN_URL=admin-secret-path/

# ===================================
# Build Info
# ===================================
VERSION=1.0.0
BUILD_DATE=2025-12-06
