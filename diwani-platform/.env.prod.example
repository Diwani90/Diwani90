# ===================================
# منصة ديواني - Production Environment Variables
# Diwani Platform - .env.prod
# ===================================
#
# تحذير أمني:
# - لا تضع هذا الملف في Git
# - استخدم AWS Secrets Manager أو HashiCorp Vault للإنتاج الحقيقي
# - غيّر جميع القيم الافتراضية قبل الإطلاق
# ===================================

# =============================
# Django Core Settings
# =============================
DEBUG=False
SECRET_KEY=your-super-secret-key-min-50-chars-use-python-secrets-module
ALLOWED_HOSTS=diwani.sa,www.diwani.sa,api.diwani.sa
DOMAIN=diwani.sa

# =============================
# Database (PostgreSQL + PostGIS)
# =============================
POSTGRES_DB=diwani_production
POSTGRES_USER=diwani_prod_user
POSTGRES_PASSWORD=super-secure-database-password-min-32-chars
DATABASE_URL=postgis://diwani_prod_user:super-secure-database-password-min-32-chars@db:5432/diwani_production

# =============================
# Redis
# =============================
REDIS_PASSWORD=super-secure-redis-password-min-32-chars
REDIS_URL=redis://:super-secure-redis-password-min-32-chars@redis:6379/0
CELERY_BROKER_URL=redis://:super-secure-redis-password-min-32-chars@redis:6379/1

# =============================
# Elasticsearch
# =============================
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_PASSWORD=elastic-secure-password-min-20-chars
ELASTICSEARCH_ENABLED=True

# =============================
# Gunicorn Settings
# =============================
GUNICORN_WORKERS=4
GUNICORN_THREADS=2

# =============================
# Celery Settings
# =============================
CELERY_CONCURRENCY=4

# =============================
# Sentry (Error Tracking)
# =============================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================
# Security & Encryption
# =============================
FIELD_ENCRYPTION_KEY=your-32-byte-encryption-key-base64-encoded
CHAT_ENCRYPTION_KEY=your-32-byte-chat-encryption-key-base64

# =============================
# Payment Gateways
# =============================
# Tap Payments
TAP_SECRET_KEY=sk_live_your_tap_secret_key
TAP_PUBLIC_KEY=pk_live_your_tap_public_key
TAP_WEBHOOK_SECRET=your_tap_webhook_secret

# Moyasar
MOYASAR_SECRET_KEY=sk_live_your_moyasar_key
MOYASAR_PUBLIC_KEY=pk_live_your_moyasar_key

# Tabby
TABBY_SECRET_KEY=sk_live_your_tabby_key
TABBY_PUBLIC_KEY=pk_live_your_tabby_key
TABBY_MERCHANT_CODE=your_tabby_merchant_code

# Tamara
TAMARA_API_TOKEN=your_tamara_api_token
TAMARA_MERCHANT_ID=your_tamara_merchant_id

# =============================
# SMS Gateway (Unifonic)
# =============================
UNIFONIC_APP_SID=your_unifonic_app_sid
UNIFONIC_SENDER_ID=DIWANI

# =============================
# Email (SendGrid / AWS SES)
# =============================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_api_key
DEFAULT_FROM_EMAIL=noreply@diwani.sa

# =============================
# AWS S3 (Media Storage)
# =============================
USE_S3=True
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=diwani-media-production
AWS_S3_REGION_NAME=me-south-1
AWS_S3_CUSTOM_DOMAIN=media.diwani.sa
AWS_DEFAULT_ACL=public-read

# =============================
# ZATCA (E-Invoicing)
# =============================
ZATCA_ENVIRONMENT=production
ZATCA_CERTIFICATE_PATH=/app/secrets/zatca/certificate.pem
ZATCA_PRIVATE_KEY_PATH=/app/secrets/zatca/private_key.pem
ZATCA_COMPLIANCE_REQUEST_ID=your_compliance_request_id
ZATCA_PIH=your_previous_invoice_hash

# =============================
# Accounting Integration
# =============================
# Qoyod
QOYOD_API_KEY=your_qoyod_api_key
QOYOD_SECRET_KEY=your_qoyod_secret_key
QOYOD_COMPANY_ID=your_qoyod_company_id

# Dafater
DAFATER_API_KEY=your_dafater_api_key
DAFATER_COMPANY_ID=your_dafater_company_id

# =============================
# Monitoring & Admin
# =============================
FLOWER_USER=admin
FLOWER_PASSWORD=super-secure-flower-password
GRAFANA_USER=admin
GRAFANA_PASSWORD=super-secure-grafana-password

# =============================
# Feature Flags
# =============================
ENABLE_TABBY=True
ENABLE_TAMARA=True
ENABLE_BNPL=True
ENABLE_ANALYTICS=True
ENABLE_NOTIFICATIONS=True

# =============================
# Rate Limiting
# =============================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute

# =============================
# Cache Settings
# =============================
CACHE_TTL=300
SESSION_COOKIE_AGE=86400
