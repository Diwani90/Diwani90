# ===================================
# منصة ديواني - Production Dockerfile
# Multi-stage build for security & size
# ===================================

# Stage 1: Build dependencies
FROM python:3.12-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir gunicorn[gevent] sentry-sdk django-prometheus


# Stage 2: Production image
FROM python:3.12-slim as production

# Build arguments
ARG BUILD_DATE
ARG VERSION=1.0.0

# Labels
LABEL maintainer="Diwani Platform <dev@diwani.sa>" \
      version="${VERSION}" \
      build-date="${BUILD_DATE}" \
      description="Diwani Platform - Saudi Building Materials Marketplace"

# Environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/opt/venv/bin:$PATH" \
    APP_HOME=/app

WORKDIR $APP_HOME

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    # PostgreSQL client
    libpq5 \
    # PostGIS runtime
    gdal-bin \
    libgdal32 \
    libgeos-c1v5 \
    libproj25 \
    # Image processing
    libjpeg62-turbo \
    libpng16-16 \
    libwebp7 \
    # Utilities
    curl \
    gettext \
    # Security updates
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# Create non-root user
RUN groupadd --system --gid 1001 diwani \
    && useradd --system --uid 1001 --gid 1001 --home-dir $APP_HOME --shell /sbin/nologin diwani

# Create necessary directories
RUN mkdir -p $APP_HOME/static $APP_HOME/media $APP_HOME/logs \
    && chown -R diwani:diwani $APP_HOME

# Copy application code
COPY --chown=diwani:diwani . .

# Remove unnecessary files
RUN rm -rf \
    .git \
    .gitignore \
    *.md \
    Dockerfile* \
    docker-compose* \
    tests/ \
    .pytest_cache \
    __pycache__ \
    *.pyc

# Switch to non-root user
USER diwani

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/api/health/ || exit 1

# Default command
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "4", "--threads", "2"]
