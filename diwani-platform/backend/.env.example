# ===================================
# منصة ديواني - Environment Variables
# Copy this file to .env and fill in your values
# ===================================

# Django Settings
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - PostgreSQL
DB_NAME=diwani_db
DB_USER=diwani_user
DB_PASSWORD=diwani_secure_pass_2025
DB_HOST=localhost
DB_PORT=5432

# Or use DATABASE_URL
# DATABASE_URL=postgis://diwani_user:diwani_secure_pass_2025@localhost:5432/diwani_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (Development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Email (Production)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@diwani.sa

# AWS S3 (Production)
# USE_S3=True
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=diwani-media
# AWS_S3_REGION_NAME=me-south-1

# Sentry (Production)
# SENTRY_DSN=your-sentry-dsn

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# SMS Provider (Unifonic/Msegat)
SMS_PROVIDER=unifonic
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=DIWANI

# Payment Gateway (Moyasar/Tap)
PAYMENT_PROVIDER=moyasar
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_SECRET_KEY=your-payment-secret-key
