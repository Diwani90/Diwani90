# =============================================================================
# ملف الإعدادات النموذجي لنظام ديواني
# Diwani Platform Configuration Example
# =============================================================================
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك
# Copy this file to .env and modify values according to your environment

# =============================================================================
# إعدادات Django الأساسية
# =============================================================================

# وضع التطوير (True) أو الإنتاج (False)
DEBUG=True

# المفتاح السري - يجب تغييره في الإنتاج!
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-change-in-production

# النطاقات المسموح بها (مفصولة بفواصل)
ALLOWED_HOSTS=localhost,127.0.0.1,api.diwani.sa

# =============================================================================
# قاعدة البيانات PostgreSQL
# =============================================================================

DATABASE_URL=postgres://user:password@localhost:5432/diwani_db

# أو بشكل منفصل:
# DB_NAME=diwani_db
# DB_USER=diwani_user
# DB_PASSWORD=secure_password
# DB_HOST=localhost
# DB_PORT=5432

# =============================================================================
# Redis (للـ Cache و Channels و Celery)
# =============================================================================

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# =============================================================================
# التشفير
# =============================================================================

# مفتاح تشفير الحقول الحساسة في قاعدة البيانات
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-32-char-encryption-key-here

# مفتاح تشفير المحادثات
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAT_ENCRYPTION_KEY=your-chat-encryption-key-here

# =============================================================================
# SMS - Unifonic (مزود الرسائل النصية للسعودية)
# =============================================================================

SMS_CONFIG__ENABLED=True
SMS_CONFIG__TEST_MODE=True
SMS_CONFIG__PROVIDER=unifonic

# بيانات Unifonic
SMS_CONFIG__UNIFONIC_APP_SID=your-unifonic-app-sid
SMS_CONFIG__UNIFONIC_SENDER_ID=DIWANI

# أو Twilio كبديل
# SMS_CONFIG__PROVIDER=twilio
# SMS_CONFIG__TWILIO_ACCOUNT_SID=your-twilio-account-sid
# SMS_CONFIG__TWILIO_AUTH_TOKEN=your-twilio-auth-token
# SMS_CONFIG__TWILIO_FROM_NUMBER=+1234567890

# =============================================================================
# Tap Payment - بوابة الدفع
# =============================================================================

TAP_PAYMENT_CONFIG__TEST_MODE=True
TAP_PAYMENT_CONFIG__SECRET_KEY=sk_test_your_tap_secret_key
TAP_PAYMENT_CONFIG__PUBLIC_KEY=pk_test_your_tap_public_key
TAP_PAYMENT_CONFIG__CALLBACK_URL=https://api.diwani.sa/payments/callback/
TAP_PAYMENT_CONFIG__REDIRECT_URL=https://diwani.sa/payment/result/
TAP_PAYMENT_CONFIG__CALLBACK_BASE_URL=http://localhost:8000

# =============================================================================
# Firebase Cloud Messaging (FCM) - إشعارات Android/Web
# =============================================================================

FCM_CONFIG__ENABLED=True
FCM_CONFIG__TEST_MODE=True
FCM_CONFIG__CREDENTIALS_FILE=/path/to/firebase-credentials.json

# =============================================================================
# Apple Push Notification Service (APNS) - إشعارات iOS
# =============================================================================

APNS_CONFIG__ENABLED=True
APNS_CONFIG__TEST_MODE=True
APNS_CONFIG__KEY_FILE=/path/to/apns-auth-key.p8
APNS_CONFIG__KEY_ID=your-key-id
APNS_CONFIG__TEAM_ID=your-team-id
APNS_CONFIG__BUNDLE_ID=sa.diwani.app
APNS_CONFIG__USE_SANDBOX=True

# =============================================================================
# البريد الإلكتروني
# =============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Diwani <noreply@diwani.sa>

# =============================================================================
# تخزين الملفات - AWS S3 أو DigitalOcean Spaces
# =============================================================================

# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=diwani-media
# AWS_S3_REGION_NAME=me-south-1

# أو التخزين المحلي (للتطوير فقط)
MEDIA_URL=/media/
STATIC_URL=/static/

# =============================================================================
# Elasticsearch (للبحث المتقدم)
# =============================================================================

ELASTICSEARCH_DSL__default__hosts=localhost:9200

# =============================================================================
# Sentry (لتتبع الأخطاء في الإنتاج)
# =============================================================================

# SENTRY_DSN=https://your-sentry-dsn

# =============================================================================
# إعدادات CORS
# =============================================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://diwani.sa

# =============================================================================
# معلومات الاتصال للنظام
# =============================================================================

SUPPORT_EMAIL=support@diwani.sa
SUPPORT_PHONE=+966500000000

# =============================================================================
# ملاحظات مهمة
# =============================================================================
#
# 1. في وضع الاختبار (TEST_MODE=True):
#    - SMS: يُطبع في console ويُحفظ في cache
#    - Payment: يُنشئ جلسات وهمية محلية
#    - Notifications: تُطبع في console
#
# 2. للإنتاج:
#    - غيّر DEBUG إلى False
#    - غيّر جميع TEST_MODE إلى False
#    - تأكد من تعيين جميع المفاتيح الحقيقية
#    - تأكد من وجود شهادات SSL
#
# 3. الحد الأدنى للإطلاق:
#    - SMS (للتسجيل)
#    - Tap Payment (للدفع)
#    - FCM أو APNS (للإشعارات)
