# ===================================
# منصة ديواني - Secure Production Dockerfile
# Hardened for Saudi NCA Compliance
# ===================================

# Build stage - Install dependencies
FROM python:3.12-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gdal-bin \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    libjpeg-dev \
    libpng-dev \
    libwebp-dev \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir gunicorn[gevent]

# Production stage - Minimal image
FROM python:3.12-slim AS production

# Security: Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Security settings
    PYTHONFAULTHANDLER=1 \
    PYTHONUTF8=1

WORKDIR /app

# Install only runtime dependencies (no compilers)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    gdal-bin \
    libgdal32 \
    libgeos-c1v5 \
    libproj25 \
    libjpeg62-turbo \
    libpng16-16 \
    libwebp7 \
    curl \
    # Clean up
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && apt-get autoremove -y

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Create non-root user with specific UID/GID
RUN groupadd --system --gid 1000 diwani \
    && useradd --system --uid 1000 --gid 1000 --home /app --shell /sbin/nologin diwani

# Create necessary directories
RUN mkdir -p /app/static /app/media /app/logs /app/.cache \
    && chown -R diwani:diwani /app

# Copy application code
COPY --chown=diwani:diwani . .

# Remove unnecessary files for security
RUN rm -rf \
    .git \
    .gitignore \
    .env* \
    *.md \
    Makefile \
    docker-compose*.yml \
    tests/ \
    docs/ \
    __pycache__ \
    *.pyc \
    .pytest_cache \
    .coverage \
    htmlcov \
    2>/dev/null || true

# Security: Remove shell access
RUN rm -f /bin/sh /bin/bash 2>/dev/null || true

# Switch to non-root user
USER diwani

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/api/health/ || exit 1

# Security labels
LABEL maintainer="Diwani Platform" \
      version="1.0.0" \
      description="Secure Django application for Diwani Platform" \
      security.compliance="NCA-ECC,PDPL"

# Default command with security options
CMD ["gunicorn", "config.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "4", \
     "--threads", "2", \
     "--worker-class", "gthread", \
     "--worker-tmp-dir", "/tmp", \
     "--timeout", "60", \
     "--graceful-timeout", "30", \
     "--keep-alive", "5", \
     "--max-requests", "1000", \
     "--max-requests-jitter", "50", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--capture-output"]
