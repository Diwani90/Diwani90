# =============================================================================
# إعدادات واجهة React لنظام ديواني
# Diwani Frontend (React) Configuration
# =============================================================================
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك
# Copy this file to .env and modify values according to your environment

# عنوان خادم Backend
# Backend API URL
REACT_APP_BACKEND_URL=http://localhost:8000

# منفذ WebSocket للتطوير
# WebSocket port for development
WDS_SOCKET_PORT=443

# =============================================================================
# للإنتاج / For Production
# =============================================================================
# REACT_APP_BACKEND_URL=https://api.diwani.sa
